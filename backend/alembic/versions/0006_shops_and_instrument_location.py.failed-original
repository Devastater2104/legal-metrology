        suffix = shop_counter[owner_id]

        if location:
            shop_name = (
                "Existing Shop"
                if suffix == 1
                else f"Existing Shop {suffix}"
            )
            address = location
        else:
            shop_name = (
                "Existing Shop"
                if suffix == 1
                else f"Existing Shop {suffix}"
            )
            address = "Address not available"

        result = connection.execute(
            sa.text(
                """
                INSERT INTO shops
                    (owner_id, name, gst_number, address, latitude, longitude, created_at)
                VALUES
                    (:owner_id, :name, NULL, :address, NULL, NULL, CURRENT_TIMESTAMP)
                """
            ),
            {
                "owner_id": owner_id,
                "name": shop_name,
                "address": address,
            },
        )

        shop_id = result.lastrowid

        if location is None:
            connection.execute(
                sa.text(
                    """
                    UPDATE instruments
                    SET shop_id = :shop_id
                    WHERE owner_id = :owner_id
                      AND location IS NULL
                    """
                ),
                {
                    "shop_id": shop_id,
                    "owner_id": owner_id,
                },
            )
        else:
            connection.execute(
                sa.text(
                    """
                    UPDATE instruments
                    SET shop_id = :shop_id
                    WHERE owner_id = :owner_id
                      AND location = :location
                    """
                ),
